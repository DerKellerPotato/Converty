[Desktop Entry]
Type=Application
Name=Converty
GenericName=PDF Toolbox
Comment=Merge, split, compress, convert and sign PDF files offline
Exec=converty %F
Icon=io.github.converty.Converty
Terminal=false
Categories=Office;Utility;
MimeType=application/pdf;image/jpeg;image/png;video/mp4;video/x-matroska;video/webm;video/quicktime;video/x-msvideo;
Keywords=pdf;merge;split;compress;convert;rotate;watermark;sign;video;mp4;mkv;audio;
StartupNotify=true
StartupWMClass=io.github.converty.Converty
